<VirtualHost *:80>
    ServerName {{ domain }}
    DocumentRoot {{ web_root }}

    <Directory {{ web_root }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/{{ domain }}-error.log
    CustomLog ${APACHE_LOG_DIR}/{{ domain }}-access.log combined
</VirtualHost>
